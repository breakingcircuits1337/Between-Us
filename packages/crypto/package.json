{
  "name": "@betweenus/crypto",
  "version": "0.1.0",
  "private": true,
  "description": "Post-quantum cryptographic primitives for BETWEENUS",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --testEnvironment node",
    "test:ci": "node --experimental-vm-modules ../../node_modules/.bin/jest --testEnvironment node --ci --coverage"
  },
  "dependencies": {
    "@noble/post-quantum": "0.2.1",
    "@noble/hashes": "1.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": {
          "lib": ["ES2020", "DOM"]
        }
      }]
    }
  }
}
