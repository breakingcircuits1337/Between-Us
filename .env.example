# BETWEENUS — Environment Variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.
#
# ─── Mobile app ───────────────────────────────────────────────────────────────

# Firebase App Check debug token (development builds only).
# Generate one in: Firebase Console → App Check → Apps → your app → Debug tokens
# Leave empty in production — native attestation (Play Integrity / App Attest) is used.
FIREBASE_APPCHECK_DEBUG_TOKEN=

# ─── Cloud Functions ──────────────────────────────────────────────────────────

# Set to "true" to reject requests without a valid App Check token.
# Defaults to false (allow, but warn) — set true before going to production.
ENFORCE_APP_CHECK=false
